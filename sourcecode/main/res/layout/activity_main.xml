<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:background="#0A0A0F"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔥 DEVIL-X WIFI 2.0"
        android:id="@+id/textView"
        android:textColor="#00E5FF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="#12121C"
        android:gravity="center"
        android:paddingTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Developer: MD Shamim | Devil-X Studios"
        android:id="@+id/textView3"
        android:background="#12121C"
        android:gravity="center"
        android:textSize="11sp"
        android:paddingBottom="10dp"
        android:textColor="#B0BEC5"
        android:layout_marginBottom="6dp" />

    <ListView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/listView"
        android:background="#0A0A0F"
        android:divider="#1A1A26"
        android:dividerHeight="1dp"
        android:layout_weight="1" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12121C"
        android:padding="8dp">

        <Button
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="🔍 স্ক্যান করুন"
            android:id="@+id/scan"
            android:background="#00A896"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:onClick="scan"
            android:layout_weight="1"
            android:layout_marginRight="4dp" />

        <Button
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="📖 নির্দেশিকা"
            android:id="@+id/button3"
            android:background="#7B2FBE"
            android:layout_weight="1"
            android:onClick="instructions"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_marginLeft="4dp" />
    </LinearLayout>

</LinearLayout>
